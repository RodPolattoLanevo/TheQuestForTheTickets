{
  "manifest_version": 3,
  "name": "The Hunt for the Tickets",
  "version": "0.1.0",
  "description": "Your RPG character's progress, right from the toolbar. Close tickets, earn XP, level up.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "The Hunt for the Tickets",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "alarms", "notifications", "tabs"],
  "host_permissions": ["http://localhost:4000/*", "http://localhost/*", "https://sacoa.zendesk.com/*"],
  "content_scripts": [
    {
      "matches": ["https://sacoa.zendesk.com/*"],
      "js": ["zendeskContent.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}
