# ============================================================================
# The Hunt for the Tickets - environment configuration
# Copy this file to .env and fill in real values. Never commit .env.
# ============================================================================

# --- Core ---
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173

# Secret used to sign session/auth JWTs. Generate with: openssl rand -hex 32
AUTH_JWT_SECRET=replace-with-a-long-random-secret

# --- Database (Postgres - Supabase in production) ---
# Local dev: either `docker compose up -d` (see docker-compose.yml at the repo root) and
# use the connection string in its comments, or point straight at a Supabase project (a
# free one is fine for dev/staging too - see docs/DEPLOYMENT.md).
#
# DATABASE_URL: the pooled/pgbouncer connection (Supabase dashboard -> Project Settings ->
# Database -> Connection string -> "Transaction" pooler, port 6543). This is what the app
# uses at runtime - required because the backend runs as short-lived Vercel serverless
# functions, which would otherwise exhaust Postgres' direct connection limit.
# DIRECT_URL: the non-pooled connection (same page, "Session"/direct, port 5432). Only
# `prisma migrate` uses this - pgbouncer's transaction mode can't run schema migrations.
DATABASE_URL="postgresql://hunt:hunt@localhost:5432/hunt"
DIRECT_URL="postgresql://hunt:hunt@localhost:5432/hunt"

# --- Ticket Data Provider ---
# Which TicketDataProvider implementation the sync engine uses.
# One of: mock | csv | zendesk-api | zendesk-webhook | google-sheets | browser-capture
TICKET_PROVIDER=mock

# Minutes between automatic sync runs (manual sync always available via Admin panel / API).
SYNC_INTERVAL_MINUTES=15

# --- Zendesk API provider (optional, only needed when TICKET_PROVIDER=zendesk-api) ---
# The subdomain in https://<this>.zendesk.com
ZENDESK_SUBDOMAIN=

# EASIEST PATH: an API token (Zendesk Admin Center -> Apps and integrations -> APIs ->
# Zendesk API -> enable token access -> Add API token), paired with the email of whoever
# generated it. No OAuth app registration needed. See ZENDESK_INTEGRATION.md.
ZENDESK_API_TOKEN=
ZENDESK_API_TOKEN_EMAIL=

# Alternative: a real OAuth access token, once the authorization-code exchange is wired up
# (see ZENDESK_INTEGRATION.md - not implemented yet, so this is a manual/temporary token).
ZENDESK_OAUTH_CLIENT_ID=
ZENDESK_OAUTH_CLIENT_SECRET=
ZENDESK_OAUTH_REDIRECT_URI=http://localhost:4000/api/integrations/zendesk/oauth/callback
ZENDESK_OAUTH_ACCESS_TOKEN=

# --- Zendesk webhook provider (optional, only needed when TICKET_PROVIDER=zendesk-webhook) ---
# Shared secret Zendesk sends back in a header (e.g. via a webhook custom header)
# so the backend can verify requests are genuinely from your Zendesk trigger.
ZENDESK_WEBHOOK_SECRET=

# --- Google Sheets provider (optional, only needed when TICKET_PROVIDER=google-sheets) ---
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# --- Feature flags ---
FEATURE_BROWSER_CAPTURE=false
FEATURE_TEAM_EVENTS=true
FEATURE_SOUND_DEFAULT_ON=false
